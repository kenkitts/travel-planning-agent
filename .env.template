# Configuration for deploying TravelAgentWebStack (the hosted web UI on
# ECS Fargate behind an OIDC-authenticated ALB — DESIGN.md decision #37,
# PLAN.md Phase 10). Optional: `cdk deploy`/`cdk synth` skip WebStack
# entirely if WEB_CERTIFICATE_ARN is unset, so you don't need this file at
# all if you're only using the CLI or running web/server.py locally.
#
# Copy this file to .env and fill in the values below. cdk/app.py loads it
# via a small dotenv-style reader (cli/agent_client.py's load_dotenv()).
#
# Note: this is a DIFFERENT Okta app/config than anything the CLI uses —
# the CLI has no ALB in front of it and authenticates to AWS with plain
# IAM/SigV4 credentials (DESIGN.md decision #37 reverted the CLI/web-UI's
# earlier Okta-JWT-bearer-token Runtime auth entirely). This Okta app is
# specifically for the ALB's `authenticate-oidc` listener rule — register
# a dedicated OIDC web application (confidential client, with a client
# secret) in your Okta org for this purpose, with the ALB's own
# https://<alb-dns-name>/oauth2/idpresponse as an allowed redirect URI.

# ARN of an existing ACM certificate for the ALB's HTTPS listener. Must
# already be issued and validated in the same region as the deployment
# (us-east-1). This project does not provision or import a certificate
# for you.
WEB_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Okta OIDC app endpoints and credentials for the ALB's authenticate-oidc
# action. Find these in your Okta org's /.well-known/openid-configuration
# document for the authorization server this app is registered under.
WEB_OIDC_ISSUER=https://your-org.okta.com/oauth2/default
WEB_OIDC_AUTHORIZATION_ENDPOINT=https://your-org.okta.com/oauth2/default/v1/authorize
WEB_OIDC_TOKEN_ENDPOINT=https://your-org.okta.com/oauth2/default/v1/token
WEB_OIDC_USER_INFO_ENDPOINT=https://your-org.okta.com/oauth2/default/v1/userinfo
WEB_OIDC_CLIENT_ID=0oaXXXXXXXXXXXXXXXXX
WEB_OIDC_CLIENT_SECRET=your-client-secret-here
