# Okta configuration for the Travel Planning Agent's dedicated OIDC app
# (see DESIGN.md decision #27 — this is a separate Okta application from
# any other Okta-authenticated tool you may have, e.g. okta-claude-code-
# token-helper's own .env).
#
# Copy this file to .env and fill in the values from your Okta app
# registration (Native Application / public client, PKCE required,
# "offline_access" scope enabled — see okta-claude-code-token-helper's
# README for the exact app-registration steps, which this project reuses
# via that script as a subprocess).
#
# cli/agent_client.py loads this file (via a small dotenv-style reader) and
# passes these as real environment variables to the token helper
# subprocess — NOT via the helper script's own .env loading, since that
# file is reserved for a different Okta app.
OKTA_ISSUER=https://your-org.okta.com/oauth2/default
OKTA_CLIENT_ID=0oaXXXXXXXXXXXXXXXXX
OKTA_SCOPES=groups offline_access
OKTA_REDIRECT_PORT=5309

# The `aud` claim AgentCore's Runtime authorizer validates against
# (RuntimeAuthorizerConfiguration.using_jwt's allowed_audience). Okta
# access tokens carry the client identifier in a `cid` claim, not the
# standard OAuth `client_id` claim AgentCore's allowedClients check
# expects — confirmed against a real decoded token, client_id was absent
# entirely — so allowedAudience/OKTA_AUDIENCE is used instead of
# OKTA_CLIENT_ID for authorization. Set this to a static, arbitrary string
# (NOT the Runtime's own ARN, which can change on recreation) configured
# as this Okta app's authorization server's Audience field (Okta Admin
# Console: Security > API > Authorization Servers > [server] > Settings).
OKTA_AUDIENCE=api://travel-planning-agent

# Absolute path to the token helper script (okta-claude-code-token.py) on
# this machine. Adjust if you cloned okta-claude-code-token-helper
# somewhere other than your home directory.
OKTA_TOKEN_HELPER_PATH=~/okta-claude-code-token-helper/okta-claude-code-token.py
